{
  "name": "parla-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @playground/ui build && pnpm --filter web dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck && tsc -p tsconfig.json",
    "check": "pnpm -r exec parla check && x18n check",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:ci": "oxlint --format=github",
    "lint:fix": "oxlint --fix",
    "parla:update": "pnpm --dir ${PARLA_DIR:-../parla} pack:all && cp ${PARLA_DIR:-../parla}/.packs/*.tgz vendor/parla/ && pnpm install --force",
    "preview": "pnpm --filter web preview"
  },
  "devDependencies": {
    "@marcalexiei/oxfmt-config": "2.0.1",
    "@marcalexiei/oxlint-config": "1.10.0",
    "@parlajs/compiler": "0.0.0",
    "@parlajs/x18n-plugin": "0.0.0",
    "@x18n/cli": "0.1.14",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
